---
import '../../src/styles/global.css';

const SIGNUP_URL = 'https://forms.gle/m2g5yZwbG3bTAeZd7';
const UIST_WORKSHOP_URL = 'https://uist.acm.org/2026/attending/#full-conference--workshop';
const BASE_URL = import.meta.env.BASE_URL;

const schedule = [
  ['09:00–10:20', 'Opening & Talks', 'Welcome and invited talks.'],
  ['10:20–10:30', 'Technique Boba-making demo', 'Demonstration of relevant preparation techniques.'],
  ['10:30–12:15', 'Task 1: Flavor entity creation + system intro', 'Taste ingredients, describe experiences, and receive the system introduction.'],
  ['12:15–13:45', 'Lunch', 'Conference lunch break.'],
  ['13:45–14:50', 'Task 2: Ingredient-led boba design', 'Select an anchor ingredient, design a drink, document the rationale, prepare, and taste.'],
  ['14:50–15:50', 'Task 3: Memory- or theme-driven boba', 'Reshape a shared memory or theme into a boba concept using earlier flavor entries.'],
  ['15:50–16:20', 'Share', 'Present drinks, open tasting, and Flavor Wiki annotation.'],
  ['16:20–17:00', 'Discussion & Close', 'Group reflection, research directions, and closing.'],
];

const organizers = [
  ['Po-Yu Chen', 'National Taiwan University', 'Taipei, Taiwan', 'https://pillowlowchen.com/', 'poyu.jpg'],
  ['Eunsol Choi', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://sol-choi.com/', 'sol.jpg'],
  ['Takuji Narumi', 'University of Tokyo', 'Tokyo, Japan', 'https://dblp.org/pid/33/5349.html', 'narumi_takuji.jpg'],
  ['Paul Pu Liang', 'MIT Media Lab / MIT EECS', 'Cambridge, MA, USA', 'https://pliang279.github.io/', 'paul-liang-headshot-small.jpg'],
  ['Jas Brooks', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://jasbrooks.com/', 'jasborrks.jpg'],
  ['Lung-Pan Cheng', 'National Taiwan University', 'Taipei, Taiwan', 'https://www.lungpancheng.tw/', 'lung_pan.jpg'],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Bobapedia: a UIST '26 workshop on archiving living flavor experiences." />
    <title>Bobapedia — Archiving Living Flavor Experiences</title>
  </head>
  <body style={`--texture-url: url("${BASE_URL}/bw-paper-texture.png")`}>
    <header class="site-header">
      <a class="wordmark" href={BASE_URL} aria-label="Bobapedia home">Bobapedia<span>✦</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#schedule">Schedule</a>
        <a href="#organizers">Organizers</a>
      </nav>
    </header>

    <main>
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><a href="https://uist.acm.org/2026/" target="_blank" rel="noreferrer">UIST ’26 workshop</a> · Detroit · November 2 2026</p>
          <h1>Can boba <br /><em>flavor</em> be captured?</h1>
          <p class="hero-intro">
            A full-day participatory workshop exploring how computational interfaces
            can help communities document, share, and collaboratively create flavor
            experiences through boba tea.
          </p>
          <div class="cta-actions hero-actions">
            <a class="button button-primary" href={UIST_WORKSHOP_URL} target="_blank" rel="noreferrer">Register for the workshop <span aria-hidden="true">↗</span></a>
            <a class="button button-sheet" href={SIGNUP_URL} target="_blank" rel="noreferrer">Sign-up sheet <span aria-hidden="true">↗</span></a>
            <a class="button button-paper" href={`${BASE_URL}/uistadjunct26-210.pdf`} download>Download paper <span aria-hidden="true">↓</span></a>
          </div>
          <p class="signup-note">The sign-up sheet helps us learn more about you before the workshop.</p>
          <p class="small-note">Workshop capacity is limited, so please register early.</p>
        </div>
        <div class="hero-art">
          <img
            class="hero-collage"
            src={`${BASE_URL}/bobatea-collage-style-4-no-bg.png`}
            alt="Bobapedia collage combining boba tea and annotated documents"
          />
        </div>
      </section>

      <section class="meta-strip">
        <div><span class="meta-label">Format</span><strong>Full-day workshop</strong></div>
        <div><span class="meta-label">Participants</span><strong>Approximately 30</strong></div>
        <div><span class="meta-label">Experience</span><strong>No culinary skills required</strong></div>
        <div><span class="meta-label">Date &amp; time</span><strong>November 2, 2026 · 9:00 AM–5:00 PM</strong></div>
        <div><span class="meta-label">Location</span><strong>Detroit Marriott at the Renaissance Center, 400 Renaissance Center, Detroit, MI 48243</strong></div>
      </section>

      <section class="section-shell section-grid merged-content" id="about">
        <div>
          <p class="eyebrow">01 — Motivation</p>
          <h2><em>Flavor</em> is notoriously difficult to represent.</h2>
        </div>
        <div class="prose">
          <p>
            Computational flavor systems often represent
food through ingredients, chemical compounds, recipe corpora, or
machine-generated recommendations, leaving limited space for
people to document and iterate their subjective experiences. 
          </p>
          <p>
            Bobapedia makes space for the archived experiences. With an LLM-supported Flavor Wiki,
            participants record sensory impressions, personal associations, and cultural
            interpretations before designing drinks together. Together, we aim to explore:
          </p>
          <blockquote>How might computational interfaces help communities articulate, share, and iteratively refine their personal interpretations of taste?</blockquote>
          <p class="meta-label outcome-label">What we leave with</p>
          <ul class="outcome-list">
            <li>A collaboratively edited Flavor Wiki</li>
            <li>Annotated ingredient entries and boba-tea concepts</li>
            <li>Sensory, cultural, and narrative design reasoning</li>
            <li>A research agenda for embodied flavor and human–AI creativity</li>
          </ul>
        </div>
      </section>

      <section class="tinted-section paper-texture" id="activities">
        <div class="section-shell">
          <div class="section-heading">
            <h2>The Process</h2>
          </div>
          <div class="activity-grid">
            <article class="activity-card"><img src={`${BASE_URL}/notice.png`} alt="Workshop participants noticing the sensory qualities of ingredients" /><span class="card-number">01</span><h3>Notice</h3><p>Taste and smell ingredients, then describe sensory attributes, memories, and cultural references.</p></article>
            <article class="activity-card"><img src={`${BASE_URL}/make_meaning.png`} alt="Workshop participants recording and comparing flavor meanings" /><span class="card-number">02</span><h3>Make meaning</h3><p>Record your experience in the Flavor Wiki and compare how different people interpret the same flavor.</p></article>
            <article class="activity-card"><img src={`${BASE_URL}/create_together.png`} alt="Workshop participants creating boba together" /><span class="card-number">03</span><h3>Create together</h3><p>Design, prepare, and taste boba drinks inspired by ingredients, memories, and shared themes.</p></article>
          </div>
        </div>
      </section>

      <section class="section-shell schedule-section" id="schedule">
        <div class="section-heading">
          <h2>Schedule</h2>
        </div>
        <div class="schedule-list" aria-label="Workshop schedule">
          {schedule.map(([time, title, description]) => (
            <div class="schedule-row">
              <time>{time}</time>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="meta-strip paper-texture logistics-strip" id="logistics">
        <div class="logistics-intro"><span class="meta-label">Who it is for</span><strong>Come curious about flavor, food, and multisensory interaction.</strong></div>
        <div><span class="meta-label">01</span><strong>Researchers</strong></div>
        <div><span class="meta-label">02</span><strong>Designers</strong></div>
        <div><span class="meta-label">03</span><strong>Practitioners</strong></div>
      </section>

      <section class="section-shell" id="organizers">
        <div class="section-heading">
          <h2>Organizers</h2>
        </div>
        <div class="organizer-grid">
          {organizers.map(([name, institution, location, website, image]) => (
            <article class="organizer">
              <img src={`${BASE_URL}/${image}`} alt={`${name} headshot`} />
              <h3><a href={website} target="_blank" rel="noreferrer">{name}</a></h3>
              <p>{institution}</p>
              <span>{location}</span>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer section-shell">
      <span class="wordmark">Bobapedia<span>✦</span></span>
      <span>UIST ’26 · Detroit, MI</span>
      <span>For inquiries, email <a href="mailto:reach@poyuchentwmail.com">reach@poyuchentwmail.com</a></span>
    </footer>
  </body>
</html>
