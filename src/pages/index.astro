---
import '../../src/styles/global.css';

const SIGNUP_URL = 'https://forms.gle/m2g5yZwbG3bTAeZd7';
const BASE_URL = import.meta.env.BASE_URL;

const schedule = [
  ['09:30–10:45', 'Opening & talks', 'Welcome, logistics, and two invited talks.'],
  ['10:45–11:05', 'Boba-making demonstration', 'A practical introduction to preparation techniques.'],
  ['11:05–12:20', 'Task 1: Flavor entity creation', 'Taste ingredients, describe experiences, and meet the Flavor Wiki.'],
  ['12:20–14:00', 'Task 2: Ingredient-led boba design', 'Design, document, prepare, and taste a drink around an anchor ingredient.'],
  ['14:00–15:30', 'Task 3: Memory- or theme-driven boba', 'Translate a shared memory or theme into a boba concept.'],
  ['15:30–16:15', 'Sharing & open tasting', 'Present drinks, taste across groups, and annotate the Flavor Wiki.'],
  ['16:15–17:30', 'Discussion & closing', 'Reflect together and identify future research directions.'],
];

const organizers = [
  ['Po-Yu Chen', 'National Taiwan University', 'Taipei, Taiwan', 'https://pillowlowchen.com/'],
  ['Eunsol Choi', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://sol-choi.com/'],
  ['Takuji Narumi', 'University of Tokyo', 'Tokyo, Japan', 'https://dblp.org/pid/33/5349.html'],
  ['Paul Pu Liang', 'MIT Media Lab / MIT EECS', 'Cambridge, MA, USA', 'https://pliang279.github.io/'],
  ['Jas Brooks', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://jasbrooks.com/'],
  ['Lung-Pan Cheng', 'National Taiwan University', 'Taipei, Taiwan', 'https://www.lungpancheng.tw/'],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Bobapedia: a UIST '26 workshop on archiving living flavor experiences." />
    <title>Bobapedia — Archiving Living Flavor Experiences</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={BASE_URL} aria-label="Bobapedia home">Bobapedia<span>✦</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#schedule">Schedule</a>
        <a href="#organizers">Organizers</a>
        <a class="nav-cta" href="#signup">Sign up</a>
      </nav>
    </header>

    <main>
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><a href="https://uist.acm.org/2026/" target="_blank" rel="noreferrer">UIST ’26 workshop</a> · Detroit · November 2–5, 2026</p>
          <h1>What does your<br /><em>flavor</em> remember?</h1>
          <p class="hero-intro">
            A full-day participatory workshop exploring how computational interfaces
            can help communities document, share, and collaboratively create flavor
            experiences through boba tea.
          </p>
          <a class="button button-primary" href="#signup">Join the workshop <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-art">
          <img
            class="hero-collage"
            src={`${BASE_URL}/bobatea-collage-style-4-no-bg.png`}
            alt="Bobapedia collage combining boba tea and annotated documents"
          />
        </div>
      </section>

      <section class="meta-strip">
        <div><span class="meta-label">Format</span><strong>Full-day workshop</strong></div>
        <div><span class="meta-label">Participants</span><strong>Approximately 30</strong></div>
        <div><span class="meta-label">Experience</span><strong>No culinary skills required</strong></div>
      </section>

      <section class="signup-section section-shell" id="signup">
        <div class="signup-card">
          <p class="eyebrow">Ready to taste differently?</p>
          <h2>Save your seat<br /><em>at the table.</em></h2>
          <p>Join the conversation, or read the workshop paper to learn more about the day.</p>
          <div class="cta-actions">
            <a class="button button-dark" href={SIGNUP_URL} target="_blank" rel="noreferrer">Sign up for Bobapedia <span aria-hidden="true">↗</span></a>
            <a class="button button-paper" href={`${BASE_URL}/uistadjunct26-210.pdf`} download>Download workshop paper <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section class="section-shell section-grid" id="about">
        <div>
          <p class="eyebrow">01 — The invitation</p>
          <h2>Flavor is more than a recipe.</h2>
        </div>
        <div class="prose">
          <p>
            Flavor is embodied, multimodal, and culturally situated. Yet computational
            flavor systems often reduce food to ingredients, chemical compounds, recipe
            corpora, or recommendations.
          </p>
          <p>
            Bobapedia makes space for the subjective. With an LLM-supported Flavor Wiki,
            participants record sensory impressions, personal associations, and cultural
            interpretations before designing drinks together.
          </p>
          <blockquote>How might computational interfaces help communities articulate, share, and iteratively refine their personal interpretations of taste?</blockquote>
        </div>
      </section>

      <section class="tinted-section" id="activities">
        <div class="section-shell">
          <div class="section-heading">
            <p class="eyebrow">02 — The experience</p>
            <h2>Taste. Articulate.<br /><em>Recompose.</em></h2>
          </div>
          <div class="activity-grid">
            <article class="activity-card"><span class="card-number">01</span><h3>Notice</h3><p>Taste and smell ingredients, then describe sensory attributes, memories, and cultural references.</p></article>
            <article class="activity-card"><span class="card-number">02</span><h3>Make meaning</h3><p>Record your experience in the Flavor Wiki and compare how different people interpret the same flavor.</p></article>
            <article class="activity-card"><span class="card-number">03</span><h3>Create together</h3><p>Design, prepare, and taste boba drinks inspired by ingredients, memories, and shared themes.</p></article>
          </div>
        </div>
      </section>

      <section class="section-shell schedule-section" id="schedule">
        <div class="section-heading">
          <p class="eyebrow">03 — A day in the workshop</p>
          <h2>From first sip<br /><em>to shared archive.</em></h2>
        </div>
        <div class="schedule-list" aria-label="Workshop schedule">
          {schedule.map(([time, title, description]) => (
            <div class="schedule-row">
              <time>{time}</time>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="tinted-section paper-texture logistics-section">
        <div class="section-shell two-column">
          <div>
            <p class="eyebrow">04 — Come as you are</p>
            <h2>A place for curious people.</h2>
          </div>
          <div class="logistics-copy">
            <p>We welcome people working across Human–Food Interaction, multisensory HCI, human–AI co-creation, computational flavor, culinary practice, and digital gastronomy.</p>
            <div class="tag-list"><span>Researchers</span><span>Designers</span><span>Practitioners</span><span>Curious eaters</span></div>
            <p class="small-note">The workshop includes tasting and small-serving food preparation. Vegan, halal, low-sugar, and other dietary alternatives will be planned where possible. Final ingredient and allergen information will be published when confirmed.</p>
          </div>
        </div>
      </section>

      <section class="section-shell" id="organizers">
        <div class="section-heading">
          <p class="eyebrow">05 — The people behind Bobapedia</p>
          <h2>Made across<br /><em>disciplines and places.</em></h2>
        </div>
        <div class="organizer-grid">
          {organizers.map(([name, institution, location, website]) => (
            <article class="organizer"><h3><a href={website} target="_blank" rel="noreferrer">{name}</a></h3><p>{institution}</p><span>{location}</span></article>
          ))}
        </div>
      </section>

      <section class="outcomes-section">
        <div class="section-shell two-column">
          <div>
            <p class="eyebrow">06 — What we will leave with</p>
            <h2>A living record<br />of <em>flavor.</em></h2>
          </div>
          <ul class="outcome-list">
            <li>A collaboratively edited Flavor Wiki</li>
            <li>Annotated ingredient entries and boba-tea concepts</li>
            <li>Sensory, cultural, and narrative design reasoning</li>
            <li>A research agenda for embodied flavor and human–AI creativity</li>
          </ul>
        </div>
      </section>

    </main>

    <footer class="site-footer section-shell">
      <span class="wordmark">Bobapedia<span>✦</span></span>
      <span>UIST ’26 · Detroit, MI</span>
      <span>Contact details coming soon</span>
    </footer>
  </body>
</html>
