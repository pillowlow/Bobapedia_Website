---
import '../../src/styles/global.css';

const SIGNUP_URL = 'https://forms.gle/m2g5yZwbG3bTAeZd7';
const UIST_WORKSHOP_URL = 'https://uist.acm.org/2026/attending/#full-conference--workshop';
const BASE_URL = import.meta.env.BASE_URL;

const schedule = [
  ['09:30–10:45', 'Opening & talks', 'Welcome, logistics, and two invited talks.'],
  ['10:45–11:05', 'Boba-making demonstration', 'A practical introduction to preparation techniques.'],
  ['11:05–12:20', 'Task 1: Flavor entity creation', 'Taste ingredients, describe experiences, and meet the Flavor Wiki.'],
  ['12:20–14:00', 'Task 2: Ingredient-led boba design', 'Design, document, prepare, and taste a drink around an anchor ingredient.'],
  ['14:00–15:30', 'Task 3: Memory- or theme-driven boba', 'Translate a shared memory or theme into a boba concept.'],
  ['15:30–16:15', 'Sharing & open tasting', 'Present drinks, taste across groups, and annotate the Flavor Wiki.'],
  ['16:15–17:30', 'Discussion & closing', 'Reflect together and identify future research directions.'],
];

const organizers = [
  ['Po-Yu Chen', 'National Taiwan University', 'Taipei, Taiwan', 'https://pillowlowchen.com/', 'poyu.jpg'],
  ['Eunsol Choi', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://sol-choi.com/', 'sol.jpg'],
  ['Takuji Narumi', 'University of Tokyo', 'Tokyo, Japan', 'https://dblp.org/pid/33/5349.html', 'narumi_takuji.jpg'],
  ['Paul Pu Liang', 'MIT Media Lab / MIT EECS', 'Cambridge, MA, USA', 'https://pliang279.github.io/', 'paul-liang-headshot-small.jpg'],
  ['Jas Brooks', 'MIT CSAIL', 'Cambridge, MA, USA', 'https://jasbrooks.com/', 'jasborrks.jpg'],
  ['Lung-Pan Cheng', 'National Taiwan University', 'Taipei, Taiwan', 'https://www.lungpancheng.tw/', 'lung_pan.jpg'],
];
